  "cliffhanger_keywords": ["鬼", "灵", "魂", "尸", "血", "诅咒", "怨灵", "凶宅", "禁地", "仪式", "献祭", "邪神", "深渊", "疯狂", "san值", "SAN值", "低语", "幻觉", "噩梦", "镜子", "门", "走廊"],
